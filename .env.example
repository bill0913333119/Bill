# 對外 HTTPS 網址（LINE 卡片、廠商回報連結使用）
PUBLIC_URL=https://defect.example.com

# 工程師端 API 金鑰（選填；設定後需在 App「設定」輸入）
APP_TOKEN=

# PostgreSQL / Supabase
DATABASE_URL=postgres://defect:defect@localhost:5432/defect

# 照片與 PDF 儲存：留空則存本機 UPLOAD_DIR；設定後改用 S3 / Cloudflare R2
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# LINE 官方帳號（Messaging API channel）與 LIFF
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
